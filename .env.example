# ---- Copy to .env for docker compose. NEVER commit real secrets. ------------------------------
ENVIRONMENT=local
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-only-secret-change-me
# DATA_ENCRYPTION_KEY: leave unset locally (a built-in, public dev-only key is used and is refused in
# staging/production). For real environments generate one and store it in your secret manager:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

POSTGRES_PASSWORD=recruiter
DATABASE_URL=postgresql+psycopg://recruiter:recruiter@postgres:5432/recruiter
REDIS_URL=redis://redis:6379/0

# AI provider: local (deterministic, no external calls) | anthropic | openai | gemini
LLM_PROVIDER=local
LLM_MODEL=
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local

# Storage: local | gcs. Compose runs a Cloud Storage emulator (fake-gcs-server); in GKE the pod's
# Workload Identity supplies credentials and STORAGE_EMULATOR_HOST is not set.
STORAGE_BACKEND=gcs
GCS_BUCKET=candidate-documents
GCP_PROJECT_ID=local-dev
STORAGE_EMULATOR_HOST=http://gcs:4443

CLAMAV_HOST=clamav
REQUIRE_MALWARE_SCAN=false

EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=Recruiting <no-reply@example.com>
SMS_BACKEND=console

CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Optional SSO (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/session/oidc
OIDC_DEFAULT_ORG_SLUG=
