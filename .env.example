# ---- Copy to .env for docker compose. NEVER commit real secrets. ------------------------------
ENVIRONMENT=local
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-only-secret-change-me
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=Zm9yLWxvY2FsLWRldi1vbmx5LWNoYW5nZS1tZS0xMjM=

POSTGRES_PASSWORD=recruiter
DATABASE_URL=postgresql+psycopg://recruiter:recruiter@postgres:5432/recruiter
REDIS_URL=redis://redis:6379/0

# AI provider: local (deterministic, no external calls) | anthropic | openai | gemini
LLM_PROVIDER=local
LLM_MODEL=
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local

# Storage: local | s3 (MinIO in compose)
STORAGE_BACKEND=s3
S3_BUCKET=candidate-documents
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

CLAMAV_HOST=clamav
REQUIRE_MALWARE_SCAN=false

EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=Recruiting <no-reply@example.com>
SMS_BACKEND=console

CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Optional SSO (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/session/oidc
OIDC_DEFAULT_ORG_SLUG=
